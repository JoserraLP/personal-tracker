rules_version = '2';

// =============================================================
// Modelo: cualquier correo de la lista puede registrarse y usar la
// app. Como el acceso ya está controlado por esa lista, todos los
// usuarios registrados se consideran "amigos" entre sí:
//   - Cada uno solo puede ESCRIBIR sus propios datos.
//   - Cualquiera de la lista puede LEER los datos de cualquier otro
//     (para la sección de Amigos).
//   - Las notificaciones son privadas: cada uno solo ve las suyas.
//
// IMPORTANTE (spec 001): la lista de correos autorizados vive en DOS
// sitios sincronizados a mano:
//   1) js/allowed-emails.js — puerta de acceso de la WEB (login con
//      Google + aviso «Tu correo no está en la lista de invitados»).
//   2) isAllowedUser() aquí abajo — protección de DATOS en el
//      servidor: esta copia es la que Firestore realmente exige.
// Para añadir o quitar un invitado: edita AMBAS listas y publica
// estas reglas en Firebase console → Firestore Database → Reglas.
// =============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    function isAllowedUser() {
      return request.auth != null && request.auth.token.email in [
        "admin@admin.es",
        "djoserralozanopinilla@gmail.com"
      ];
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    match /users/{userId} {
      // El perfil (nombre, foto, email) lo puede ver cualquier usuario
      // autorizado, para poder listar "amigos". Solo el dueño lo edita.
      allow read: if isAllowedUser();
      allow write: if isAllowedUser() && isOwner(userId);

      match /movies/{itemId} {
        allow read: if isAllowedUser();
        allow write: if isAllowedUser() && isOwner(userId);
      }

      match /series/{itemId} {
        allow read: if isAllowedUser();
        allow write: if isAllowedUser() && isOwner(userId);
      }

      match /books/{itemId} {
        allow read: if isAllowedUser();
        allow write: if isAllowedUser() && isOwner(userId);
      }

      match /games/{itemId} {
        allow read: if isAllowedUser();
        allow write: if isAllowedUser() && isOwner(userId);
      }

      // Sección de recetas (issue #64): recetas, catálogo de
      // ingredientes, menús semanales y etiquetas propias. Mismo
      // patrón que el resto: lectura entre amigos autorizados,
      // escritura solo del dueño.
      match /recipes/{itemId} {
        allow read: if isAllowedUser();
        allow write: if isAllowedUser() && isOwner(userId);
      }

      match /ingredients/{itemId} {
        allow read: if isAllowedUser();
        allow write: if isAllowedUser() && isOwner(userId);
      }

      match /menus/{itemId} {
        allow read: if isAllowedUser();
        allow write: if isAllowedUser() && isOwner(userId);
      }

      match /tags/{itemId} {
        allow read: if isAllowedUser();
        allow write: if isAllowedUser() && isOwner(userId);
      }

      // Sección de gimnasio (issue #62): entrenos y catálogo de
      // ejercicios. Mismo patrón que el resto: lectura entre amigos
      // autorizados, escritura solo del dueño.
      match /gym-workouts/{itemId} {
        allow read: if isAllowedUser();
        allow write: if isAllowedUser() && isOwner(userId);
      }

      match /gym-exercises/{itemId} {
        allow read: if isAllowedUser();
        allow write: if isAllowedUser() && isOwner(userId);
      }

      // Lista de deseos (Compras): cosas que comprar con precio,
      // descripción, URL y foto (por URL). A diferencia del registro
      // de ocio, es una lista PRIVADA: solo el dueño la lee o
      // escribe (nadie más la necesita).
      match /wishlist/{itemId} {
        allow read, write: if isAllowedUser() && isOwner(userId);
      }

      // Experiences (Experiences tab): exper done or to do some day
      // with title, description, date and done mark. Private list
      // like the wishlist: only the owner reads or writes it.
      match /experiences/{itemId} {
        allow read, write: if isAllowedUser() && isOwner(userId);
      }

      // Las notificaciones son privadas: nadie más puede leerlas.
      match /notifications/{notifId} {
        allow read, write: if isAllowedUser() && isOwner(userId);
      }
    }
  }
}
